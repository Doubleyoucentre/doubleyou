# Public destination only; never place payment/provider credentials in Vite variables.
# Leave blank/false until the separately deployed Hall of Fame release passes payment acceptance.
VITE_HALL_OF_FAME_ORIGIN=
VITE_HALL_OF_FAME_READY=false
# Optional approved, public-only JSON endpoint. Leave empty until the public data service is ready.
# CORS must allow this website; no cookies, API keys or private/admin endpoints.
VITE_HALL_OF_FAME_PUBLIC_API=
# Optional public hosted checkout URL, confirmed live and company-owned by Doubleyou.
# Accepts Flutterwave /pay/ or /donate/ pages, or Paystack /pay/ pages.
# Leave blank until verified. Never place a provider secret/API key here.
VITE_SUPPORT_PAYMENT_URL=
